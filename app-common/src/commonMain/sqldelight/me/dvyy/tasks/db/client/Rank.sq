import com.benasher44.uuid.Uuid;

CREATE TABLE IF NOT EXISTS rank (
  uuid BLOB AS Uuid PRIMARY KEY NOT NULL,
  parent BLOB AS Uuid NOT NULL,
  rank TEXT NOT NULL,
  UNIQUE (parent, rank)
);

selectAllUUIDs:
SELECT uuid FROM rank;

upsert:
INSERT OR REPLACE INTO rank VALUES ?;

delete:
DELETE FROM rank WHERE uuid = ?;

nextItem:
SELECT * FROM rank
WHERE parent = ? AND rank > ?
ORDER BY rank LIMIT 1;

getRank:
SELECT rank FROM rank WHERE uuid = ?;

getUuidForRank:
SELECT uuid FROM rank WHERE parent = ? AND rank = ?;

getOrderForParent:
SELECT uuid FROM rank WHERE parent = ? ORDER BY rank;

getRankAfter:
SELECT rank FROM rank
WHERE parent = ? AND rank > ?
ORDER BY rank LIMIT 1;

getRankBefore:
SELECT rank FROM rank
WHERE parent = ? AND rank < ?
ORDER BY rank DESC LIMIT 1;

lastRank:
SELECT rank FROM rank
WHERE parent = ?
ORDER BY rank DESC LIMIT 1;

firstRank:
SELECT rank FROM rank
WHERE parent = ?
ORDER BY rank LIMIT 1;
