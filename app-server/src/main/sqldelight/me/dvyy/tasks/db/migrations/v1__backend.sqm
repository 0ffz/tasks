import kotlin.Boolean;
import me.dvyy.tasks.model.ListId;
import kotlinx.datetime.Instant;
import me.dvyy.tasks.model.network.NetworkMessage;
import me.dvyy.tasks.model.EntityType;
import me.dvyy.tasks.model.Highlight;
import me.dvyy.tasks.model.TaskId;

CREATE TABLE IF NOT EXISTS userEntity (
  id SERIAL PRIMARY KEY,
  username TEXT UNIQUE NOT NULL
);

CREATE TABLE IF NOT EXISTS message (
  uuid UUID NOT NULL,
  modified INT8 AS Instant NOT NULL,
  inserted INT8 AS Instant NOT NULL,
  type TEXT AS NetworkMessage.Type NOT NULL,
  entityType TEXT AS EntityType NOT NULL,
  userId INTEGER NOT NULL REFERENCES userEntity (id) ON DELETE CASCADE,
  PRIMARY KEY (uuid, userId)
);

CREATE INDEX IF NOT EXISTS message_user ON message (userId);

CREATE TABLE IF NOT EXISTS taskList (
  uuid UUID AS ListId NOT NULL,
  isProject BOOLEAN NOT NULL,
  title TEXT,
  rank INT8 NOT NULL,
  userId INTEGER NOT NULL REFERENCES userEntity (id) ON DELETE CASCADE,
  PRIMARY KEY (uuid, userId)
);

CREATE INDEX IF NOT EXISTS taskList_user ON taskList (userId);

CREATE TABLE IF NOT EXISTS rank (
  uuid UUID NOT NULL,
  parent UUID,
  rank TEXT NOT NULL,
  userId INTEGER NOT NULL REFERENCES userEntity (id) ON DELETE CASCADE,
  UNIQUE (parent, rank, userId),
  PRIMARY KEY (uuid, userId)
);

CREATE TABLE IF NOT EXISTS task (
  uuid UUID AS TaskId NOT NULL,
  text TEXT,
  highlight TEXT AS Highlight NOT NULL,
  completed BOOLEAN NOT NULL,
  list UUID AS ListId NOT NULL,
  userId INTEGER NOT NULL REFERENCES userEntity (id) ON DELETE CASCADE,
  PRIMARY KEY (uuid, userId)
);

CREATE INDEX IF NOT EXISTS tasks_userId ON task (userId);
