upsert:
INSERT INTO rank VALUES ?
ON CONFLICT(uuid, userId) DO UPDATE SET rank = excluded.rank, parent = excluded.parent;

delete:
DELETE FROM rank WHERE userId = ? AND uuid = ?;

nextItem:
SELECT * FROM rank
WHERE userId = ? AND parent = ? AND rank > ?
ORDER BY rank LIMIT 1;

get:
SELECT * FROM rank WHERE userId = ? AND parent = ? AND rank = ?;
