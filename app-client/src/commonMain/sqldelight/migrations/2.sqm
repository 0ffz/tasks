DROP TRIGGER IF EXISTS Zsave_message_for_rank;

CREATE TABLE message_dg_tmp (
  uuid BLOB NOT NULL,
  modified INTEGER NOT NULL,
  type TEXT NOT NULL,
  entityType TEXT NOT NULL,
  PRIMARY KEY (uuid, entityType)
);

INSERT INTO message_dg_tmp(uuid, modified, type, entityType)
SELECT uuid, modified, type, entityType
FROM message;

DROP TABLE message;

ALTER TABLE message_dg_tmp RENAME TO message;

CREATE INDEX message_modified ON message(modified);

CREATE TRIGGER save_message_for_rank
AFTER INSERT ON rank
BEGIN
    INSERT OR REPLACE INTO message(uuid, modified, type, entityType)
    VALUES (new.uuid, (strftime('%s','now') || substr(strftime('%f','now'),4)), 'Update', 'RANK');
END;
